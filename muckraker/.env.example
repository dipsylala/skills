# Muckraker credentials. All optional: each source falls back to public pages without one.
# Copy to .env, fill in the keys you have, and load it into your environment (see README, "Credentials").
# .env is git-ignored; never commit real keys.

# UK Companies House REST API key (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# CourtListener API token (free account): https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# OpenCorporates API token: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=

# OpenSanctions API key (free for non-commercial use): https://www.opensanctions.org/licensing/
OPENSANCTIONS_API_KEY=

# SEC User-Agent, sent to sec.gov only. Set it to skip the question on every run;
# leave it blank and the coordinator asks each time.
# Format: a name, a space, then an email address, quoted because of the spaces:
#   MUCKRAKER_SEC_UA="Jane Smith jane@example.com"
# mr.py refuses to query sec.gov with a value in any other form.
MUCKRAKER_SEC_UA=
